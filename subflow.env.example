# Core subtitle service only
# Platform: plex, jellyfin, emby, or filesystem
SUBFLOW_PLATFORM=plex
SUBFLOW_SERVER_URL=http://plex:32400
SUBFLOW_SERVER_TOKEN=replace-me
# Required for Jellyfin and Emby; leave empty for Plex or filesystem.
SUBFLOW_SERVER_USER_ID=
# Path seen by the media server. It maps to SUBFLOW_MEDIA_ROOT inside this container.
SUBFLOW_SERVER_PATH_PREFIX=/volume1/MediaForPlex
SUBFLOW_MEDIA_ROOT=/media
# Used only by filesystem mode.
SUBFLOW_FILESYSTEM_EXTENSIONS=.mkv,.mp4,.avi,.m4v,.mov,.ts,.webm
SUBFLOW_STATE_DIR=/state
SUBFLOW_SCAN_INTERVAL_SECONDS=1800
SUBFLOW_SYNC_ENABLED=true
SUBFLOW_CLEAN_SOURCE_OUTPUT=true

# Language-learning pair (BCP-47). Names are optional for common languages.
SUBFLOW_SOURCE_LANGUAGE=en
SUBFLOW_SOURCE_LANGUAGE_NAME=
SUBFLOW_TARGET_LANGUAGE=zh-TW
SUBFLOW_TARGET_LANGUAGE_NAME=
SUBFLOW_TARGET_LANGUAGE_STYLE=natural, concise dialogue suitable for subtitles
# target-first puts the learning language above the source; source-first reverses the lines.
SUBFLOW_BILINGUAL_ORDER=target-first
# Two existing language files are merged by timing only above this confidence threshold.
SUBFLOW_BILINGUAL_MERGE_TOLERANCE_MS=350
SUBFLOW_BILINGUAL_MERGE_MIN_MATCH_RATIO=0.7

# Translation: GLM primary, OpenAI-compatible fallback optional
SUBFLOW_TRANSLATION_ENABLED=true
SUBFLOW_TRANSLATION_BASE_URL=https://api.z.ai/api/coding/paas/v4
SUBFLOW_TRANSLATION_API_KEY=replace-me
SUBFLOW_TRANSLATION_MODEL=glm-5-turbo
SUBFLOW_TRANSLATION_DISABLE_THINKING=true
SUBFLOW_FALLBACK_BASE_URL=https://openrouter.ai/api/v1
SUBFLOW_FALLBACK_API_KEY=
SUBFLOW_FALLBACK_MODEL=deepseek/deepseek-v3.2
SUBFLOW_FALLBACK_DISABLE_THINKING=false

# Polling works on every platform without an inbound port. Enable webhooks only when the media
# server or a trusted proxy can add SubFlow's Authorization: Bearer header.
SUBFLOW_WEBHOOK_ENABLED=false
SUBFLOW_API_HOST=127.0.0.1
SUBFLOW_API_PORT=9292
SUBFLOW_API_TOKEN=generate-with-subflow-generate-token
SUBFLOW_TRUSTED_HOSTS=localhost,127.0.0.1
